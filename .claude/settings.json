{
  "permissions": {
    "allow": [
      "Bash(git status)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command'); printf '[%s] %s\\n' \"$(date +'%Y-%m-%d %H:%M:%S')\" \"$cmd\" >> .claude/bash-history.log"
          }
        ]
      }
    ]
  }
}
